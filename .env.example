# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# Secrets are better stored in n8n's own credential screens (encrypted at rest).
# scripts/import-credentials.sh copies the PSI key, Google client and webhook token
# into n8n; scripts/n8n.sh passes only the non-credential values to n8n.

# --- PageSpeed Insights ---------------------------------------------------
# Google Cloud API key restricted to the PageSpeed Insights API.
PSI_API_KEY=

# --- Slack ------------------------------------------------------------------
# Incoming webhook URL for #pagespeed-alerts. Treat it like a password: anyone
# with it can post to the channel.
SLACK_WEBHOOK_URL=

# --- Google Sheets ------------------------------------------------------------
# The ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# Not secret. Sheets access itself uses an OAuth credential created in n8n.
GOOGLE_SHEET_ID=

# --- AI step (scripts/analyze.js) -------------------------------------------
# Uses the locally signed-in Claude Code CLI (found on PATH). No API key here on purpose.
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=180000
# Set to 1 to skip Claude and use the deterministic fallback (demos, outages).
ANALYZE_FORCE_FALLBACK=0

# --- On-demand webhook --------------------------------------------------------
# Shared secret sent as header X-Webhook-Token. Generate with: openssl rand -hex 24
WEBHOOK_TOKEN=
